# In production (PostgreSQL):
# DATABASE_URL=postgres://cheremo_user:cheremo_password@localhost:5432/cheremosphere_db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis / Channels Configuration (for WebSockets real-time chat & notifications)
REDIS_URL=redis://localhost:6379/0

# Storage / Cloudinary / AWS S3 (for profile images, marketplace product photos, private CV storage)
STORAGE_BACKEND=local
